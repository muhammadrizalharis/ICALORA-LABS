[Unit]
Description=ICALORA-LABS ingest worker (embed)
After=network.target icalora-backend.service

[Service]
Type=simple
WorkingDirectory=/home/muhammadrizalharis/ICALORA-LABS/backend
ExecStart=/home/muhammadrizalharis/ICALORA-LABS/backend/.venv/bin/python -u -m app.ingest.embed --target 1000000 --batch 16 --pause 0.25
Restart=always
RestartSec=10
StandardOutput=append:/home/muhammadrizalharis/ICALORA-LABS/backend/.logs/ingest_embed.log
StandardError=append:/home/muhammadrizalharis/ICALORA-LABS/backend/.logs/ingest_embed.log

[Install]
WantedBy=default.target
