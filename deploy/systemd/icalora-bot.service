[Unit]
Description=ICALORA-LABS Telegram bot (long-polling)
After=network.target icalora-backend.service

[Service]
Type=simple
WorkingDirectory=%h/ICALORA-LABS/backend
ExecStart=%h/ICALORA-LABS/backend/.venv/bin/python -m app.bot.telegram_bot
Restart=always
RestartSec=5
StandardOutput=append:%h/ICALORA-LABS/backend/.logs/service_bot.log
StandardError=append:%h/ICALORA-LABS/backend/.logs/service_bot.log

[Install]
WantedBy=default.target
