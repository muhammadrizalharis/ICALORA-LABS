[Unit]
Description=ICALORA-LABS backend (FastAPI/uvicorn)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/ICALORA-LABS/backend
ExecStart=%h/ICALORA-LABS/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 58010
Restart=always
RestartSec=3
StandardOutput=append:%h/ICALORA-LABS/backend/.logs/service_backend.log
StandardError=append:%h/ICALORA-LABS/backend/.logs/service_backend.log

[Install]
WantedBy=default.target
