[Unit]
Description=ICALORA-LABS ingest worker (pmc)
After=network.target icalora-backend.service

[Service]
Type=simple
WorkingDirectory=%h/ICALORA-LABS/backend
ExecStart=%h/ICALORA-LABS/backend/.venv/bin/python -u -m app.ingest.pmc --target 1000000
Restart=always
RestartSec=10
StandardOutput=append:%h/ICALORA-LABS/backend/.logs/ingest_pmc.log
StandardError=append:%h/ICALORA-LABS/backend/.logs/ingest_pmc.log

[Install]
WantedBy=default.target
