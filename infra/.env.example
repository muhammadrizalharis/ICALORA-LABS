# === Contoh konfigurasi infra ICALORA-LABS ===
# Salin file ini menjadi .env lalu isi dengan nilai rahasia Anda sendiri.
# JANGAN pernah commit file .env asli ke repo (sudah diblokir .gitignore).

# PostgreSQL
POSTGRES_USER=icalora
POSTGRES_PASSWORD=ganti_dengan_password_kuat
POSTGRES_DB=icalora
POSTGRES_PORT=54432

# Redis
REDIS_PASSWORD=ganti_dengan_password_kuat
REDIS_PORT=54379

# SeaweedFS (object storage, S3-compatible)
# Kredensial S3 diatur di seaweedfs/s3.json (juga rahasia, di-gitignore)
S3_ACCESS_KEY=icalora
S3_SECRET_KEY=ganti_dengan_secret_kuat
S3_PORT=54333
S3_FILER_PORT=54888
