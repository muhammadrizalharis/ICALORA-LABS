# === Konfigurasi backend ICALORA-LABS (contoh) ===
# Salin ke .env dan isi nilai rahasia. JANGAN commit .env asli.
APP_ENV=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000

# PostgreSQL (samakan dgn infra/.env)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=54432
POSTGRES_USER=icalora
POSTGRES_PASSWORD=ganti_dengan_password_infra
POSTGRES_DB=icalora

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=54379
REDIS_PASSWORD=ganti_dengan_password_infra

# SeaweedFS S3
S3_ENDPOINT=http://127.0.0.1:54333
S3_ACCESS_KEY=icalora
S3_SECRET_KEY=ganti_dengan_secret_infra
S3_REGION=us-east-1
S3_BUCKET=icalora

# LLM (Ollama bersama di server)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBED_MODEL=bge-m3
LLM_TIMEOUT=120
# Durasi model tetap di VRAM setelah panggilan terakhir: "5m" (default),
# "0" = lepas VRAM segera (hemat untuk server bersama 24/7), "-1" = selalu residen.
OLLAMA_KEEP_ALIVE=5m

# Ingest korpus (mailto polite-pool; isi email Anda sendiri)
CONTACT_EMAIL=you@example.com
INGEST_PAGE_SIZE=200
CORE_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
NCBI_API_KEY=

# Bot Telegram (privat) — isi token dari @BotFather; JANGAN commit token asli
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_BOT_SECRET=
BACKEND_BASE_URL=http://127.0.0.1:58010
